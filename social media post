<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Social Profile Page</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background: #f4f4f4;
    }

    .profile {
      background: #0077b6;
      color: white;
      padding: 20px;
      text-align: center;
    }

    .profile img {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 3px solid white;
    }

    .profile h1 {
      margin: 10px 0 5px;
    }

    .profile p {
      margin: 0;
    }

    .container {
      max-width: 600px;
      margin: 20px auto;
      background: white;
      padding: 20px;
      border-radius: 10px;
    }

    .new-post textarea {
      width: 100%;
      padding: 10px;
      resize: none;
      font-size: 16px;
      border: 1px solid #ccc;
      border-radius: 6px;
    }

    .new-post button {
      margin-top: 10px;
      padding: 10px 15px;
      background: #0077b6;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    .new-post button:hover {
      background: #005f87;
    }

    .timeline {
      margin-top: 30px;
    }

    .post {
      background: #e9ecef;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 8px;
    }

    .post p {
      margin: 0;
    }

    .timestamp {
      font-size: 12px;
      color: #555;
      margin-top: 5px;
    }
  </style>
</head>
<body>

  <div class="profile">
    <img src="https://via.placeholder.com/100" alt="Profile Picture" />
    <h1>John Doe</h1>
    <p>Web Developer | Tech Enthusiast | Travel Blogger</p>
  </div>

  <div class="container">
    <div class="new-post">
      <h3>Create a new post</h3>
      <textarea id="postText" rows="3" placeholder="What's on your mind?"></textarea>
      <button onclick="addPost()">Post</button>
    </div>

    <div class="timeline" id="timeline">
      <!-- Posts will appear here -->
    </div>
  </div>

  <script>
    function addPost() {
      const textArea = document.getElementById("postText");
      const postText = textArea.value.trim();
      if (postText === "") return;

      const postDiv = document.createElement("div");
      postDiv.className = "post";

      const content = document.createElement("p");
      content.innerText = postText;

      const timestamp = document.createElement("div");
      timestamp.className = "timestamp";
      const now = new Date();
      timestamp.innerText = `Posted on ${now.toLocaleDateString()} at ${now.toLocaleTimeString()}`;

      postDiv.appendChild(content);
      postDiv.appendChild(timestamp);

      const timeline = document.getElementById("timeline");
      timeline.prepend(postDiv);

      textArea.value = "";
    }
  </script>

</body>
</html>
