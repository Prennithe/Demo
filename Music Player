<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Simple Music Player</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #222;
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px;
    }

    h1 {
      margin-bottom: 20px;
    }

    .player {
      background: #333;
      padding: 20px;
      border-radius: 10px;
      text-align: center;
      max-width: 300px;
    }

    .controls button {
      margin: 10px 5px;
      padding: 10px 15px;
      font-size: 16px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      background: #555;
      color: white;
    }

    .controls button:hover {
      background: #777;
    }

    ul {
      list-style: none;
      padding: 0;
      margin-top: 20px;
    }

    li {
      margin: 5px 0;
      cursor: pointer;
      color: #ccc;
    }

    li.active {
      color: #0f0;
    }
  </style>
</head>
<body>

  <h1>🎵 Simple Music Player</h1>
  <div class="player">
    <p id="nowPlaying">Now Playing: -</p>
    <audio id="audio" controls style="width: 100%; display: none;"></audio>
    <div class="controls">
      <button onclick="prevSong()">⏮ Prev</button>
      <button onclick="playPause()">▶️ Play/Pause</button>
      <button onclick="nextSong()">⏭ Next</button>
    </div>
    <ul id="playlist">
      <!-- Playlist items will be added here -->
    </ul>
  </div>

  <script>
    const songs = [
      { name: "Song 1", file: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" },
      { name: "Song 2", file: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3" },
      { name: "Song 3", file: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3" }
    ];

    let current = 0;
    const audio = document.getElementById("audio");
    const nowPlaying = document.getElementById("nowPlaying");
    const playlist = document.getElementById("playlist");

    function loadSong(index) {
      current = index;
      audio.src = songs[current].file;
      nowPlaying.innerText = "Now Playing: " + songs[current].name;
      highlightActive();
    }

    function playPause() {
      if (audio.paused) {
        audio.play();
      } else {
        audio.pause();
      }
    }

    function nextSong() {
      current = (current + 1) % songs.length;
      loadSong(current);
      audio.play();
    }

    function prevSong() {
      current = (current - 1 + songs.length) % songs.length;
      loadSong(current);
      audio.play();
    }

    function highlightActive() {
      [...playlist.children].forEach((li, i) => {
        li.className = i === current ? "active" : "";
      });
    }

    // Initialize playlist
    songs.forEach((song, index) => {
      const li = document.createElement("li");
      li.innerText = song.name;
      li.onclick = () => {
        loadSong(index);
        audio.play();
      };
      playlist.appendChild(li);
    });

    loadSong(current);
  </script>

</body>
</html>
